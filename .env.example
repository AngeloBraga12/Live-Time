# Tudo é opcional: sem nenhuma variável, `npm start` sobe site + API juntos.

# Porta pública do site (plataformas como Render/Railway/Fly definem sozinhas).
# PORT=3000

# Porta interna da API local (não precisa ser exposta).
# F1_LIVETIMING_API_PORT=3001

# Use apenas se a f1-livetiming-api estiver hospedada em outro lugar.
# Com um host não-local, a API local NÃO é iniciada.
# F1_LIVETIMING_API_URL=https://sua-api.exemplo.com

# "false" impede que o site inicie a API local.
# F1_LIVETIMING_API_AUTOSTART=true

# Minutos sem conexão com o feed da F1 antes de reiniciar a API (0 desativa).
# F1_LIVETIMING_WATCHDOG_MINUTES=5
